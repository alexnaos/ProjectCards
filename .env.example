# =============================================================================
# project-cards — переменные окружения
# Скопируй в .env и заполни. .env НЕ коммитить в git.
# =============================================================================

# --- LLM (OpenAI-совместимый API) -------------------------------------------
# Подходит: OpenAI, OpenRouter, Together, Groq, локальный Ollama (/v1),
# LM Studio (/v1), vLLM и т.п. Если llm.enabled=false в config.yaml — не нужно.
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Примеры:
# OpenRouter:   LLM_BASE_URL=https://openrouter.ai/api/v1
#               LLM_MODEL=anthropic/claude-3.5-sonnet
# Ollama:       LLM_BASE_URL=http://localhost:11434/v1
#               LLM_MODEL=llama3.1:8b
#               LLM_API_KEY=ollama          # любой непустой
# Groq:         LLM_BASE_URL=https://api.groq.com/openai/v1
#               LLM_MODEL=llama-3.1-70b-versatile

# Таймаут запроса к LLM, секунды
LLM_TIMEOUT=60
# Кол-во ретраев при 429/5xx
LLM_MAX_RETRIES=3

# --- Поиск изображений (опционально) ---------------------------------------
# Если images.web_search.enabled=false в config.yaml — не нужно.
SERPAPI_KEY=

# --- Пути (переопределяют config.yaml, если заданы) ------------------------
# VAULT_PATH=/absolute/path/to/vault

# --- Логирование -----------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Прочее ----------------------------------------------------------------
# Пользовательский агент для скачивания изображений
HTTP_USER_AGENT=project-cards/1.0 (+obsidian-vault-bot)
# Таймаут HTTP, секунды
HTTP_TIMEOUT=30